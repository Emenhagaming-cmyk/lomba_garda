FROM composer:2 AS dependencies
WORKDIR /app
COPY composer.json composer.lock ./
RUN composer install --no-dev --no-interaction --no-progress --optimize-autoloader --no-scripts

FROM node:22-alpine AS frontend
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY resources ./resources
COPY vite.config.js ./
RUN npm run build

FROM dunglas/frankenphp:1-php8.4-bookworm AS base
RUN cp "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini" \
    && install-php-extensions intl zip pdo_mysql
WORKDIR /app

FROM base AS application
COPY --from=dependencies --chown=www-data:www-data /app/vendor ./vendor
COPY --from=frontend --chown=www-data:www-data /app/public/build ./public/build
COPY --chown=www-data:www-data . .
COPY --from=dependencies /usr/bin/composer /usr/bin/composer
RUN echo "=== DIAG composer ===" && composer --version && \
    echo "=== DIAG vendor/laravel ===" && ls vendor/laravel/ && \
    echo "=== DIAG pail in installed.php ===" && (grep -i "pail" vendor/composer/installed.php | head -8 || echo "NO pail in installed.php") && \
    echo "=== DIAG packages.php? ===" && (grep -i "pail" bootstrap/cache/packages.php 2>/dev/null || echo "NO packages.php / no pail")
RUN composer dump-autoload --no-dev --classmap-authoritative
RUN chown -R www-data:www-data storage bootstrap/cache

COPY Caddyfile /etc/frankenphp/Caddyfile
RUN setcap CAP_NET_BIND_SERVICE=+eip /usr/local/bin/frankenphp \
    && chown -R www-data:www-data /config/caddy /data/caddy

ENV PORT=80 \
    APP_ENV=production \
    APP_DEBUG=false \
    LOG_CHANNEL=stderr \
    CACHE_STORE=array \
    SESSION_DRIVER=database \
    QUEUE_CONNECTION=sync

USER www-data
EXPOSE 80
CMD ["frankenphp", "run", "--config", "/etc/frankenphp/Caddyfile"]